# Neon (https://neon.tech) direct connection string (no "-pooler"); pgvector is built in.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# SEC EDGAR requires "Name email@example.com" (not a key, no signup)
SEC_USER_AGENT=

# LLM: Groq free tier (https://console.groq.com). Claude is optional later.
LLM_PROVIDER=groq
GROQ_API_KEY=
ANALYSIS_MODEL=openai/gpt-oss-120b
LIVE_MODEL=openai/gpt-oss-20b
CHAT_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=

# Speech-to-text: Whisper on Groq (same key) for batch; Deepgram streaming for live mode
# (https://console.deepgram.com, free credit on signup).
STT_MODEL=whisper-large-v3
LIVE_STT_MODEL=nova-3
DEEPGRAM_API_KEY=

# Embeddings: "provider/model", voyage or gemini. Both are compared on the retrieval
# eval; Voyage won. Free keys: https://dash.voyageai.com, https://aistudio.google.com
EMBEDDING_MODEL=voyage/voyage-4
VOYAGE_API_KEY=
GEMINI_API_KEY=

# Not used yet: live mode fans events out inside the one API process. Needed only if the
# API runs as several processes. Upstash gives a rediss:// URL.
REDIS_URL=
