# Neon (https://neon.tech) direct connection string (no "-pooler"); pgvector is built in.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# SEC EDGAR requires "Name email@example.com" (not a key, no signup)
SEC_USER_AGENT=

# LLM: Groq free tier (https://console.groq.com). Claude is optional later.
LLM_PROVIDER=groq
GROQ_API_KEY=
ANALYSIS_MODEL=openai/gpt-oss-120b
LIVE_MODEL=openai/gpt-oss-20b
ANTHROPIC_API_KEY=

# Phase 3+: speech-to-text and embeddings
DEEPGRAM_API_KEY=
VOYAGE_API_KEY=

# Optional, only needed from Phase 5 (live mode). Upstash gives a rediss:// URL.
REDIS_URL=
